# Copier ce fichier en .env puis adapter les valeurs. Le fichier .env n'est jamais commité.

# --- Django ---
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=a-remplacer
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Base de données ---
# Sans DATABASE_URL, le projet utilise SQLite (db.sqlite3).
# Avec Docker (docker compose up -d), décommenter la ligne suivante :
# DATABASE_URL=postgres://skillforge:skillforge@127.0.0.1:5432/skillforge
POSTGRES_DB=skillforge
POSTGRES_USER=skillforge
POSTGRES_PASSWORD=skillforge

# --- Redis et Celery ---
REDIS_URL=redis://127.0.0.1:6379/0
# True : les tâches s'exécutent dans le processus web, sans Redis ni worker (dépannage).
CELERY_TASK_ALWAYS_EAGER=False

# --- E-mails (production uniquement ; en dev ils s'affichent dans la console) ---
DEFAULT_FROM_EMAIL=SkillForge <no-reply@skillforge.tn>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- IA ---
# mock : réponses déterministes, sans réseau (tests, CI, démo hors ligne).
# gemini : API Gemini ; clé à créer sur https://aistudio.google.com/apikey
# La vraie clé se met uniquement dans .env, jamais dans ce fichier (le dépôt est public).
AI_PROVIDER=mock
AI_API_KEY=
# Vide : gemini-2.5-flash.
AI_MODEL=
AI_TIMEOUT=60
#
# Exemple pour Gemini, à recopier dans .env après avoir révoqué la clé exposée :
# AI_PROVIDER=gemini
# AI_API_KEY=votre-cle-gemini
# AI_MODEL=gemini-2.5-flash

# --- Démo (seed_demo) ---
DEMO_PASSWORD=

# --- Production (config.settings.prod) ---
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=True
SECURE_COOKIES=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
